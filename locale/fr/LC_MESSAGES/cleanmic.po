msgstr "Inactif"

# ── Input group ───────────────────────────────────────────────────────────────
msgid "Input"
msgstr "Entrée"

msgid "Microphone"
msgstr "Microphone"

msgid "Physical input device to clean"
msgstr "Périphérique d'entrée physique à filtrer"

msgid "Default"
msgstr "Par défaut"

msgid "No input device available"
msgstr "Aucun microphone disponible"

msgid "unplugged"
msgstr "débranché"

msgid "Enable"
msgstr "Activer"

msgid "Filter noise from the microphone signal"
msgstr "Filtrer le bruit du signal du microphone"

# ── Engine group ──────────────────────────────────────────────────────────────
msgid "Engine"
msgstr "Moteur"

msgid "Model"
msgstr "Modèle"

msgid "The algorithm used to filter noise"
msgstr "L'algorithme utilisé pour filtrer le bruit"

msgid "Khip (not installed)"
msgstr "Khip (non installé)"

msgid "Not detected — copy libkhip.so to ~/.local/lib/"
msgstr "Non détecté — copiez libkhip.so dans ~/.local/lib/"

msgid "Noise suppression"
msgstr "Suppression du bruit"

msgid "How aggressively noise is removed"
msgstr "Agressivité de la suppression du bruit"

