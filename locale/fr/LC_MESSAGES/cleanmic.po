msgstr "Élevé"

# ── Strength picker ───────────────────────────────────────────────────────────
msgid "Strength"
msgstr "Intensité"

msgid "Light"
msgstr "Légère"

msgid "Balanced"
msgstr "Équilibrée"

msgid "Strong"
msgstr "Forte"

# ── Mode picker (D-03/D-04) ───────────────────────────────────────────────────
# Distinct control from Strength/Intensité above: Mode is the CPU/quality
# trade-off, Strength is suppression aggressiveness. "Standard" (not
# "Balanced") is used for the middle entry so this plain gettext msgid never
# collides with Strength's own "Balanced" msgid above, which would otherwise
# force an identical French translation for two different concepts.
msgid "Mode"
msgstr "Mode"

msgid "Low CPU"
msgstr "Faible consommation"

msgid "Standard"
msgstr "Standard"

msgid "Max Quality"
msgstr "Qualité maximale"

# ── Levels group ──────────────────────────────────────────────────────────────
msgid "Levels"
msgstr "Niveaux"

msgid "Output"
msgstr "Sortie"

# ── Settings group ────────────────────────────────────────────────────────────
msgid "Settings"
msgstr "Paramètres"

msgid "Start on login"
msgstr "Démarrer à la connexion"

msgid "Launch CleanMic automatically when you log in"
msgstr "Lancer CleanMic automatiquement lors de la connexion"

msgid "Listen to processed mic"
msgstr "Écouter le micro filtré"

msgid "Route processed audio to your headphones"
msgstr "Acheminer le son filtré vers vos écouteurs"

# ── Tray notification ─────────────────────────────────────────────────────────
msgid "CleanMic is still running"
msgstr "CleanMic tourne toujours en arrière-plan"

msgid "The window was closed but CleanMic continues processing your microphone in the background. Look for the tray icon to reopen or quit."
msgstr "La fenêtre est fermée mais CleanMic continue de traiter votre microphone en arrière-plan. Cherchez l'icône dans la barre système pour rouvrir ou quitter."

# ── Tray menu ─────────────────────────────────────────────────────────────────
msgid "CleanMic active"
msgstr "CleanMic actif"

msgid "CleanMic (unavailable)"
msgstr "CleanMic (indisponible)"

msgid "Monitor"
msgstr "Moniteur"

msgid "Open CleanMic"
msgstr "Ouvrir CleanMic"

msgid "Quit"
msgstr "Quitter"

# ── No tray notification ──────────────────────────────────────────────────────
msgid "No system tray detected"
msgstr "Aucune zone de notification détectée"

msgid "Install the AppIndicator extension to minimize CleanMic to tray. Closing the window will quit the application."
msgstr "Installez l'extension AppIndicator pour réduire CleanMic dans la zone de notification. Fermer la fenêtre quittera l'application."

# ── About dialog ──────────────────────────────────────────────────────────────
msgid "About CleanMic"
msgstr "À propos de CleanMic"

# ── Support / donation ────────────────────────────────────────────────────────
msgid "Support CleanMic"
msgstr "Soutenir CleanMic"

# ── PipeWire notifications ────────────────────────────────────────────────────
msgid "PipeWire disconnected"
msgstr "PipeWire déconnecté"

msgid "The audio daemon disconnected. Attempting to reconnect…"
msgstr "Le daemon audio s'est déconnecté. Tentative de reconnexion…"

msgid "PipeWire reconnected"
msgstr "PipeWire reconnecté"

msgid "Audio processing has been restored."
msgstr "Le traitement audio a été rétabli."

msgid "PipeWire reconnect failed"
msgstr "Reconnexion PipeWire échouée"

msgid "Could not reconnect to the audio daemon. Audio processing is unavailable. Please restart CleanMic or check that PipeWire is running."
msgstr "Impossible de se reconnecter au daemon audio. Le traitement audio est indisponible. Veuillez redémarrer CleanMic ou vérifier que PipeWire est en cours d'exécution."

# ── Audio thread health notifications ────────────────────────────────────────
msgid "Audio processing stopped"
msgstr "Traitement audio arrêté"

msgid "The audio thread has stopped. Attempting to restart..."
msgstr "Le fil audio s'est arrêté. Tentative de redémarrage..."

msgid "Audio processing unavailable"
msgstr "Traitement audio indisponible"

msgid "Could not restart audio processing. Please restart CleanMic."
msgstr "Impossible de redémarrer le traitement audio. Veuillez redémarrer CleanMic."

# ── v1.1 additions (Phase 7.1) ────────────────────────────────────────────────
msgid "Noise Processing"
msgstr "Suppression du bruit"

msgid "Check for updates"
msgstr "Rechercher des mises à jour"

msgid "Download"
msgstr "Télécharger"

# ── v1.0.2 additions (Phase 08.3) ─────────────────────────────────────────────

# D-02: Notification title for update available (already wrapped in src, missing msgstr)
msgid "Update available"
msgstr "Mise à jour disponible"

# D-02: Notification title for manual check when already up to date
msgid "CleanMic is up to date"
msgstr "CleanMic est à jour"

# D-02: Notification body prefix for manual check when already up to date
msgid "You're running the latest version:"
msgstr "Vous utilisez la dernière version :"

# D-01: Banner title — %s is replaced with the new version tag (e.g. "v1.0.2")
msgid "CleanMic %s available"
msgstr "CleanMic %s disponible"

# D-01: Notification body — %s is replaced with the new version tag
msgid "CleanMic %s is available. Click Download to get it."
msgstr "CleanMic %s est disponible. Cliquez sur Télécharger pour l'obtenir."

# D-01: Engine subtitle — DeepFilterNet
msgid "High quality (default)"
msgstr "Haute qualité (par défaut)"

# D-01: Engine subtitle — RNNoise
msgid "Lightweight, low CPU"
msgstr "Léger, faible consommation CPU"

# D-01: Engine subtitle — Khip
msgid "User-supplied, adaptive"
msgstr "Fourni par l'utilisateur, adaptatif"

# Phase 15.1 Plan 06: Engine subtitle — DPDFNet-2 (window + tray selector).
# Per D-06: relative PROCESSOR USE only, never a quality-hierarchy claim —
# replaces Plan 04's now-removed "DPDFNet, lighter" placeholder wording.
msgid "DPDFNet, lower processor use"
msgstr "DPDFNet, utilisation processeur plus faible"

# Phase 15.1 Plan 06: Engine subtitle — DPDFNet-8 (window + tray selector).
# Per D-06: replaces Plan 04's "DPDFNet, higher quality" placeholder, which
# implied an unsupported quality ranking.
msgid "DPDFNet, higher processor use"
msgstr "DPDFNet, utilisation processeur plus élevée"

# Phase 15.2 Plan 02: DPDFNet-8 static weak-CPU caveat (D-02) — appended after
# the subtitle above. Gentle, static note only: never a measured hardware
# verdict, never an auto-switch — just points at the manual Low CPU Mode
# remedy (D-03/D-04).
msgid "May glitch on a slower processor — try Low CPU Mode"
msgstr "Peut saccader sur un processeur plus lent — essayez le mode Faible consommation"

# Phase 15.2 Plan 02: Mode row subtitle — D-04 engine-scope hint (window).
msgid "Only affects the DPDFNet engines"
msgstr "Affecte uniquement les moteurs DPDFNet"

# Phase 15.1 Plan 06: Generic unavailable-row title suffix (window + tray),
# e.g. "DPDFNet-2 (unavailable)". Never used for Khip, which keeps its own
# more actionable "Khip (not installed)" copy above.
msgid "(unavailable)"
msgstr "(indisponible)"

# Phase 15.1 Plan 06: Unavailable-row subtitle — engine's Cargo feature was
# not compiled into this build (src/ui/window.rs, src/tray.rs).
msgid "Not included in this build"
msgstr "Non inclus dans cette version"

# Phase 15.1 Plan 06: Unavailable-row subtitle — engine's bundled runtime/
# model asset could not be found at runtime (src/ui/window.rs, src/tray.rs).
msgid "Required files not found"
msgstr "Fichiers requis introuvables"

# 260508-k7q: Notification title — fired on first hidden autostart launch (src/app.rs)
msgid "CleanMic is running"
msgstr "CleanMic est en cours d'exécution"

# 260508-k7q: Notification body — first hidden autostart launch
msgid "The window has been hidden. Click the tray icon to open it."
msgstr "La fenêtre a été masquée. Cliquez sur l'icône système pour la rouvrir."

# 260510-ec4: Hamburger menu — opens https://github.com/claude-gagne/CleanMic/issues/new (src/ui/window.rs)
msgid "Report an issue"
msgstr "Signaler un problème"

# Phase 15.1 Plan 05: Engine fallback notice — D-11 (src/engine/mod.rs).
# Followed by the truthfully-ACTIVE engine's untranslated proper-noun name
# (e.g. "DeepFilterNet"), never the failed/requested engine's name.
msgid "Unable to start the selected engine — using instead:"
msgstr "Impossible de démarrer le moteur sélectionné — utilisation de :"
